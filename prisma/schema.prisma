generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  fullName        String    @map("full_name")
  avatar          String?
  email           String    @unique
  phoneNumber     String    @unique @map("phone_number")
  googleId        String?   @unique @map("google_id")
  password        String
  refreshToken    String?   @map("refresh_token")
  defaultAddress  Json?     @map("default_address")
  role            Role      @default(USER)
  isVerified      Boolean   @default(false) @map("is_verified")
  isActive        Boolean   @default(true) @map("is_active")
  wishlist        WishlistItem[]

  lastLogin       DateTime? @map("last_login")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique 
  subtitle  String
  image     String
  slug      String   @unique
  isActive  Boolean  @default(true)  
  order     Int      @default(1)     
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at") 

  products  Product[] 

  offers    OfferCategory[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  logo      String?
  slug      String   @unique
  isActive  Boolean  @default(true)  @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")   
  updatedAt DateTime @updatedAt      @map("updated_at")   

  products  Product[]

  offers    OfferBrand[]

  @@map("brands")
}

model Product {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String
  price        Float
  salePrice    Float?
  onSale       Boolean  @default(false) @map("on_sale")

  images       String[]

  badge        String?
  isNew        Boolean  @default(false) @map("is_new")
  isActive     Boolean  @default(true)  @map("is_active")  
  freeShipping Boolean  @default(false) @map("free_shipping")

  wishlist     WishlistItem[]

  trustBadges  String[] @map("trust_badges")

  stock        Int      @default(0)
  rating       Float    @default(0)
  reviewCount  Int      @default(0)     @map("review_count")
  specifications Json?
  features     String[]
  
  categoryId   String   @map("category_id")
  brandId      String   @map("brand_id")

  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  reviews      Review[]

  offers       OfferProduct[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  @@map("products")
}

model Review {
  id        String   @id @default(uuid())  
  name      String
  rating    Int
  text      String
  createdAt DateTime @default(now())  @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)  
  @@map("reviews")
}

model WishlistItem{
  id       String   @id              @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields:[userId], references:[id], onDelete:Cascade)
  product   Product  @relation(fields:[productId], references:[id], onDelete:Cascade)

  @@unique([userId,productId])
  @@map("wishlist_items")
}

enum OfferType{
  PERCENTAGE 
  FIXED
}

model Offer{
  id               String     @id @default(uuid())
  title            String     
  description      String?
  bannerImage      String     @map("banner_image")
  offerType        OfferType  @map("offer_type")
  offerValue       Float      @map("offer_value")

  startDate        DateTime   @map("start_date")
  endDate          DateTime   @map("end_date")
  isActive         Boolean    @default(true)        @map("is_active")

  products         OfferProduct[]
  brands           OfferBrand[]
  categories       OfferCategory[]

  createdAt        DateTime   @default(now())       @map("created_at")
  updatedAt        DateTime   @updatedAt            @map("updated_at")

  @@map("offers") 
}

model OfferProduct{
  id               String     @id    @default(uuid())
  offerId          String     @map("offer_id")
  productId        String     @map("product_id")

  offer            Offer      @relation(fields:[offerId], references:[id], onDelete:Cascade)
  product          Product    @relation(fields:[productId],references:[id], onDelete:Cascade)


  @@unique([offerId,productId])
  @@map("offer_products")
}

model OfferBrand{
  id               String     @id    @default(uuid())
  offerId          String     @map("offer_id")
  brandId          String     @map("brand_id")

  offer            Offer      @relation(fields:[offerId], references:[id], onDelete:Cascade)
  brand            Brand      @relation(fields:[brandId], references:[id],onDelete:Cascade)

  @@unique([offerId, brandId])
  @@map("offer_brands")   
}

model OfferCategory{
  id               String      @id     @default(uuid())
  offerId          String      @map("offer_id")
  categoryId       String      @map("category_id")

  offer            Offer       @relation(fields:[offerId], references:[id],onDelete:Cascade)
  category         Category    @relation(fields:[categoryId],references:[id],onDelete:Cascade)

  @@unique([offerId, categoryId])
  @@map("offer_categories")
}
